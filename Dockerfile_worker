# https://hub.docker.com/_/debian
FROM docker.io/debian:testing-slim AS build
MAINTAINER Jelmer Vernooij <jelmer@jelmer.uk>

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update --yes \
 && apt-get install --yes --no-install-recommends \
        auto-apt-proxy \
        iproute2 \
 && apt-get satisfy --yes --no-install-recommends \
        ca-certificates \
        cargo \
        libpython3-dev \
        libssl-dev \
        pkg-config \
        protobuf-compiler \
        python3-minimal \
 && apt-get clean

COPY . /code

RUN cargo build --verbose --release --manifest-path /code/worker/Cargo.toml



# https://hub.docker.com/_/debian
FROM docker.io/debian:testing-slim
MAINTAINER Jelmer Vernooij <jelmer@jelmer.uk>

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update --yes \
 && apt-get install --yes --no-install-recommends \
        auto-apt-proxy \
        iproute2 \
        tini-static \
 && apt-get upgrade --yes \
 && apt-get satisfy --yes --no-install-recommends \
        ca-certificates \
        libpython3-dev \
        python3-breezy \
        brz-debian \
        dpkg-dev \
        debhelper \
        lintian \
        sbuild \
        schroot \
        mmdebstrap \
 && apt-get clean

# unshare mode is the only sbuild chroot mode that works unprivileged in a rootless container
RUN echo "root:1:65535" > /etc/subuid \
 && echo "root:1:65535" > /etc/subgid \
 && echo '$chroot_mode = "unshare";' >> /etc/sbuild/sbuild.conf

# lintian-brush is stuck in unstable, blocked from testing by Debian #1143751
RUN printf 'Types: deb\nURIs: http://deb.debian.org/debian\nSuites: unstable\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n' > /etc/apt/sources.list.d/unstable.sources \
 && printf 'Package: *\nPin: release a=unstable\nPin-Priority: 100\n' > /etc/apt/preferences.d/unstable-pin \
 && apt-get update --yes \
 && apt-get satisfy --yes --no-install-recommends -t unstable \
        lintian-brush \
 && apt-get clean

COPY --from=build /code/target/release/janitor-worker /usr/local/bin/janitor-worker

COPY autopkgtest-wrapper /usr/local/bin/autopkgtest-wrapper

ENV AUTOPKGTEST=/usr/local/bin/autopkgtest-wrapper

EXPOSE 9821

# tini-static reaps zombies that janitor-worker, running as PID 1, would otherwise leave.
ENTRYPOINT ["tini-static", "--", "janitor-worker", "--port=9821", "--listen-address=0.0.0.0"]
