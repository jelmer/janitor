[Unit]
Description=janitor git_store (tier 0)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/jelmer/janitor/git_store:latest
ContainerName=janitor-git-store
Network=host
# --listen-address 127.0.0.1 overrides the image's own baked-in
# --listen-address=0.0.0.0 (Dockerfile_git_store's ENTRYPOINT) - see
# worker.container.j2's own comment for why this needs overriding rather
# than an Entrypoint replacement, and why the override itself is safe
# (argparse keeps the last occurrence of a repeated flag). Caddy already
# proxies the public port (/git/* -> localhost:9924); nothing needs this
# reachable beyond the host.
Exec=--listen-address 127.0.0.1 --port=9923 --public-port=9924 --config /mnt/janitor/janitor.conf --vcs-path /mnt/janitor/data/git
Volume={{ janitor_home }}:/mnt/janitor:rw

# We already pulled this exact image explicitly in roles/janitor_source
# - never re-check the registry on every service start (quadlet's default
# for a :latest tag). That re-check was slow enough on this network to
# blow TimeoutStartSec below, failing the start outright even though the
# image was already present locally.
Pull=never

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=60

[Install]
WantedBy=default.target
