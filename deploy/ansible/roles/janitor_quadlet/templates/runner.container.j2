[Unit]
Description=janitor runner (tier 2, needs git_store's public port)
After=network-online.target janitor-git_store.service janitor-differ.service janitor-archive.service
Wants=network-online.target

[Container]
Image=ghcr.io/jelmer/janitor/runner:latest
ContainerName=janitor-runner
Network=host
# --listen-address 127.0.0.1 overrides the image's own baked-in
# --listen-address=0.0.0.0 (Dockerfile_runner's ENTRYPOINT) - see
# worker.container.j2's own comment for why this needs overriding rather
# than an Entrypoint replacement, and why the override itself is safe
# (argparse keeps the last occurrence of a repeated flag). The worker's
# own backchannel to this port already goes via localhost (Network=host,
# same box); nothing needs this reachable beyond the host.
Exec=--listen-address 127.0.0.1 --port=9911 --public-port=9919 --config /mnt/janitor/janitor.conf --public-vcs-location=http://localhost:9924/
Volume={{ janitor_home }}:/mnt/janitor:rw
Volume=/home/{{ ansible_user }}/.config/breezy:/root/.config/breezy:ro

# We already pulled this exact image explicitly in roles/janitor_source
# - never re-check the registry on every service start (quadlet's default
# for a :latest tag). That re-check was slow enough on this network to
# blow TimeoutStartSec below, failing the start outright even though the
# image was already present locally.
Pull=never

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=60

[Install]
WantedBy=default.target
